{
  "name": "oliver",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo: React (Vite) + Node.js (Express) + PostgreSQL",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/client\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:client": "npm run dev -w apps/client",
    "build": "npm run build -w apps/client",
    "db:create": "npm run db:create -w apps/server",
    "db:migrate": "npm run db:migrate -w apps/server",
    "db:seed": "npm run db:seed -w apps/server",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed",
    "test": "npm test -w apps/server && npm test -w apps/client",
    "test:server": "npm test -w apps/server",
    "test:client": "npm test -w apps/client",
    "test:db": "npm run test:db -w apps/server",
    "test:all": "npm test && npm run test:db"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
