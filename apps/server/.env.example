PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL (base de datos del proyecto: oliver)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_password
PGDATABASE=oliver

# Opciones del pool de PostgreSQL
PG_POOL_MAX=10
# true para bases de datos en la nube que exigen SSL (Neon, Supabase, RDS...)
PGSSL=false

# ── Inteligencia artificial ─────────────────────────────────────────────
# Proveedor activo: gemini | mock (mock = respuestas falsas, sin red ni coste).
# Cambiar de proveedor solo requiere modificar esta variable.
AI_PROVIDER=gemini
# Parámetros comunes a cualquier proveedor
AI_TEMPERATURE=0.4
# Holgado: en Gemini 2.5 los tokens de "thinking" cuentan dentro de este máximo
AI_MAX_OUTPUT_TOKENS=4096
# Tiempo máximo por llamada al proveedor (timeout -> HTTP 504)
AI_TIMEOUT_MS=30000
# Reintentos ante errores transitorios (rate limit, 5xx, red). Si el proveedor pide esperar
# más de AI_RETRY_MAX_WAIT_MS, no se espera: se responde 429 con Retry-After.
AI_MAX_RETRIES=1
AI_RETRY_MAX_WAIT_MS=5000
# Versión del prompt del reporte (archivo prompts/session-report.<version>.md)
REPORT_PROMPT_VERSION=v1

# Gemini API (Google AI Studio) — https://aistudio.google.com/apikey
# La clave solo vive en el servidor: nunca usar el prefijo VITE_ ni exponerla al cliente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
