{
  "name": "@oliver/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:create": "node --env-file-if-exists=.env scripts/create-db.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "test:db": "node --env-file-if-exists=.env --test \"test/integration/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
